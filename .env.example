# Copy thành .env.local (đã được .gitignore bỏ qua) rồi điền giá trị thật.
# KHÔNG ghi mật khẩu vào .env - file đó đang được commit lên GitHub.
# Trên Vercel: khai báo các biến này trong Project Settings → Environment Variables.

# ---- Trang quản trị /admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Tuỳ chọn: chuỗi ngẫu nhiên dài để ký cookie đăng nhập.
# Bỏ trống thì tự suy ra từ email + mật khẩu (đổi mật khẩu = đăng xuất mọi phiên).
ADMIN_SESSION_SECRET=

# ---- API đăng tin tức từ phần mềm khác (/api/news) - xem docs/news-api.md
# Chuỗi ngẫu nhiên ít nhất 20 ký tự. Nhiều key thì cách nhau bằng dấu phẩy.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEWS_API_KEY=

# ---- Lưu nội dung bằng commit GitHub (bắt buộc trên Vercel, tuỳ chọn khi chạy local)
# Fine-grained token: chỉ chọn repo này, quyền "Contents: Read and write".
GITHUB_TOKEN=
# Dạng owner/ten-repo. Trên Vercel có thể bỏ trống (tự lấy repo đang deploy).
GITHUB_REPO=kkhakkha204/nextgencyvite
# Nhánh Vercel deploy production. Trên Vercel có thể bỏ trống (tự lấy nhánh đang deploy).
GITHUB_BRANCH=master
